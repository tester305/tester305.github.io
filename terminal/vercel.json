{
  "version": 2,
  "builds": [
    {
      "src": "api/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "terminal/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/neofetch",
      "dest": "/api/server.js"
    },
    {
      "src": "/terminal/(.*)",
      "dest": "/terminal/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/terminal/index.html"
    }
  ]
}
